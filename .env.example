# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Persistent SQLite Database File Path
# Point DB_PATH to a persistent mounted volume in production (e.g. /data/sunviloz.sqlite)
# so all orders, users, pads, logos, issued PDFs, and backups survive container restarts/redeployments.
# Defaults to ./data/sunviloz.sqlite when unset.
DB_PATH=

# Optional Google Apps Script Web App URL for local preview proxy mode.
# In production, deploy /gas/ (including gas/Index.html) directly to Google Apps Script —
# no Express server or SQLite database is required.
APPS_SCRIPT_WEBAPP_URL=

# Optional verified Primary Google Account Owner email (e.g. your Google Drive owner account).
# Used strictly to gate Admin Google password reset in local preview mode.
AUTHORIZED_GOOGLE_OWNER_EMAIL=

# Initial admin password for the fixed initial admin account (scc@gmail.com) in local preview mode.
# Stored only as a salted scrypt hash in SQLite; treated as an EXACT value including symbols.
ADMIN_PASSWORD=

# Optional stable secret (min 16 chars) for signing persistent revocable device sessions across server restarts
SESSION_SECRET=

# Optional Secondary Google Drive Apps Script Backup Bridge (for daily auto-backups)
SECONDARY_DRIVE_WEBAPP_URL=
SECONDARY_DRIVE_SYNC_SECRET=

# Supported lifecycle commands:
#   Install: npm install
#   Typecheck: npm run lint
#   Build Web SPA: npm run build
#   Build Google Apps Script HTML Bundle (gas/Index.html): npm run build:gas
#   Export Existing SQLite Data for Google Sheets Migration: npm run export:sqlite
#   Dev Preview: npm run dev
